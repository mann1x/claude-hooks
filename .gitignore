# Local config — contains MCP URLs and possibly auth headers
config/claude-hooks.json
config/*.local.json

# Logs
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# OS junk
.DS_Store
Thumbs.db

# OpenWolf (managed per-project, not committed upstream)
.wolf/

# claudemem/mnemex index (local, machine-specific)
.claudemem/

# axon / gitnexus indices (local, machine-specific — per-host code graphs)
.axon/
.gitnexus/

# Environment
.env

# Editor
.vscode/
.idea/
*.swp

# Caliber (local state)
.caliber/

# Consultants per-project session artifacts (summary.md / transcript.md /
# metadata.json / transcript.db). transcript.db carries full LLM
# payloads — system prompts, tool results, intermediate model
# reasoning. Don't commit them upstream. Per-project benchmark labels
# under docs/benchmarks/<host>/ are committed deliberately as audit
# data; the per-session live artifacts under .claude-hooks/ are not.
.claude-hooks/consultants/
# The active per-project /consultants config carries host-specific
# secrets (e.g. the pgvector DSN), so it stays local. The committed
# `.claude-hooks/consultants.example.toml` template is the shareable
# placeholder-only copy — copy it to consultants.toml to use.
.claude-hooks/consultants.toml
.claude-hooks-disable

# Claude Code project hooks (installed per-machine)
.claude/hooks/
.claude/settings.json

# code_graph: cache + manifest are local incremental-build state.
# graph.json + GRAPH_REPORT.md + _meta.json are the team-shareable
# outputs (commit those if you want collaborators to use them).
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.code-graph-build.lock

# Stray local artifacts that have caught us out before — bench
# scratch JSONs at the repo root, config backup files written by
# install.py during dev iterations, and locally-experimented
# Ollama Modelfiles. Ignored so a careless ``git add -A`` doesn't
# sweep them into a feature commit.
/bench-*.json
/config/claude-hooks.json.bak-*
/modelfiles/

# Vendored llamafile binaries + composite artifacts. The binary
# blobs are huge (100s of MB) and reproducible from upstream via
# the committed SHA256SUMS file. We commit the per-version README,
# LICENSE.upstream, and SHA256SUMS — not the binaries themselves.
vendor/llamafile/v*/llamafile-*
vendor/llamafile/v*/zipalign-*
vendor/llamafile/v*/whisperfile-*
vendor/llamafile/v*/*.zip
vendor/llamafile/models/*.gguf
vendor/llamafile/models/*.gguf.symlink
vendor/llamafile/dist/*.llamafile

# Skill-eval per-run outputs (M11 protocol). The bench produces
# large per-trial sandboxes with the model-generated code on disk
# — those stay ignored. The small per-run conclusions
# (``report.md`` / ``quota.md`` / ``metadata.json``) are
# commit-eligible: the ``--commit-report`` flag on ``coder_bench``
# force-adds them after a run, so the ledger row in
# ``docs/consultants-skill-eval-baselines.md`` always has a
# clickable artifact alongside it. Manual ``git add -f`` of
# specific files also works.
benchmarks/consultants/results/**/*
!benchmarks/consultants/results/**/
!benchmarks/consultants/results/**/report.md
# A per-date README is the interpretation of a run set — which run is
# citable, which is superseded and why. The reports alone don't carry
# that, and a superseded number with no note beside it is worse than
# no number.
!benchmarks/consultants/results/**/README.md
!benchmarks/consultants/results/**/NOTES.md
!benchmarks/consultants/results/**/report-by-language.md
!benchmarks/consultants/results/**/smoke-report.md
!benchmarks/consultants/results/**/quota.md
!benchmarks/consultants/results/**/metadata.json
!benchmarks/consultants/results/**/smoke-metadata.json
# Offline rejudge (rejudge.py) conclusions: the cross-judge re-score
# and comparative-ladder *reports* are commit-eligible, but the bulky
# regenerable payloads (trials-rejudged.jsonl, ladder.jsonl) stay
# ignored like trials.jsonl — re-derivable from the persisted sandboxes.
!benchmarks/consultants/results/**/rescore-report.md
!benchmarks/consultants/results/**/ladder-report.md


# Local developer overrides for test-fixture network identifiers (URLs,
# DSNs, hosts). See tests/README.md and tests/_fixtures_net.py — this
# file lets contributors point the test suite at their real infra
# without leaking those values into version control.
tests/.env.local
